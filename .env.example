# Groq API Key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Server
PORT=3000
NODE_ENV=development

# InfluxDB (for K6 metrics)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_DB=k6

# Grafana
GRAFANA_PORT=3001

# K6 Docker image
K6_DOCKER_IMAGE=grafana/k6:latest

# Scripts directory (mounted volume in Docker, local path otherwise)
SCRIPTS_DIR=./scripts/generated
